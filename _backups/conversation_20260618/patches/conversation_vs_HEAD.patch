+std::vector<int64_t> MixtureOfExpertsImpl::ensure_experts_cached_batch(
+    const std::vector<int64_t>& global_expert_indices, bool update_stats) {
+    struct PendingLoad {
+        size_t slot;
+        int64_t eid;
+        size_t out_index;
+    };
+
+    std::vector<int64_t> result(global_expert_indices.size(), -1);
+    std::vector<PendingLoad> pending;
+
+    {
+        std::unique_lock<std::mutex> lock(expert_slots_mutex_);
+        ++access_clock_;
+
+        for (size_t i = 0; i < global_expert_indices.size(); ++i) {
+            const int64_t global_expert_idx = global_expert_indices[i];
+
+            for (size_t s = 0; s < expert_slots_indices.size(); ++s) {
+                if (expert_slots_indices[s] != global_expert_idx) {
+                    continue;
+                }
+                const bool was_ready = expert_slot_ready_[s];
+                if (!was_ready) {
+                    expert_slots_cv_.wait(lock, [this, s]() { return expert_slot_ready_[s]; });
+                }
+                if (update_stats) {
+                    cache_hits_++;
+                    if (!suppress_predictor_stats_ && s < slot_load_origin_.size() &&
+                        slot_load_origin_[s] == 1) {
+                        if (was_ready) {
+                            prefetch_hits_ready_++;
+                        } else {
+                            prefetch_hits_wait_++;
+                        }
+                    }
+                    slot_meta_[s].access_count++;
+                    slot_meta_[s].last_access = access_clock_;
+                    slot_meta_[s].clock_bit = 1;
+                }
+                result[i] = static_cast<int64_t>(s);
+                break;
+            }
+            if (result[i] >= 0) {
+                continue;
+            }
+
+            if (update_stats) {
+                cache_misses_++;
+            }
+
+            size_t victim_slot = pick_victim_ready();
+            while (victim_slot == kNoVictimSlot) {
+                expert_slots_cv_.wait(lock, [this]() {
+                    for (bool ready : expert_slot_ready_) {
+                        if (ready) {
+                            return true;
+                        }
+                    }
+                    return false;
+                });
+                victim_slot = pick_victim_ready();
+            }
+
+            expert_slot_ready_[victim_slot] = false;
+            expert_slots_indices[victim_slot] = global_expert_idx;
+            slot_meta_[victim_slot].expert_id = global_expert_idx;
+            slot_meta_[victim_slot].access_count = 1;
+            slot_meta_[victim_slot].last_access = access_clock_;
+            slot_meta_[victim_slot].clock_bit = 1;
+            pending.push_back({victim_slot, global_expert_idx, i});
+        }
+
+        if (!pending.empty() && expert_cache_bitmask_.size() == static_cast<size_t>(num_experts_)) {
+            std::fill(expert_cache_bitmask_.begin(), expert_cache_bitmask_.end(), 0);
+            for (auto eid : expert_slots_indices) {
+                if (eid >= 0 && eid < static_cast<int64_t>(expert_cache_bitmask_.size())) {
+                    expert_cache_bitmask_[eid] = 1;
+                }
+            }
+        }
+    }
+
+    if (!pending.empty()) {
+        unified_llm_w4a16_common::log_parallel_inter_expert_io_once();
+        const bool parallel_loads = unified_llm_w4a16_common::parallel_inter_expert_loads();
+        auto load_one = [this](size_t slot, int64_t eid) {
+            load_expert_weights(slot, eid, weights_dir_);
+        };
+        auto mark_failed = [this](size_t slot) {
+            std::lock_guard<std::mutex> lock(expert_slots_mutex_);
+            expert_slot_ready_[slot] = true;
+            expert_slots_indices[slot] = -1;
+            slot_meta_[slot].expert_id = -1;
+            if (slot < slot_load_origin_.size()) {
+                slot_load_origin_[slot] = 0;
+            }
+            expert_slots_cv_.notify_all();
+        };
+
+        if (parallel_loads) {
+            std::vector<std::future<void>> futures;
+            futures.reserve(pending.size());
+            for (const auto& p : pending) {
+                stall_loads_++;
+                futures.push_back(std::async(std::launch::async, load_one, p.slot, p.eid));
+            }
+            for (size_t i = 0; i < futures.size(); ++i) {
+                try {
+                    futures[i].get();
+                } catch (...) {
+                    mark_failed(pending[i].slot);
+                    throw;
+                }
+            }
+        } else {
+            for (const auto& p : pending) {
+                stall_loads_++;
+                try {
+                    load_one(p.slot, p.eid);
+                } catch (...) {
+                    mark_failed(p.slot);
+                    throw;
+                }
+            }
+        }
+
+        (void)hipDeviceSynchronize();
