+def _policy_label(label: str, lambda_val: float) -> Optional[str]:
+    s = str(label)
+    if s == "Neither (LRU)":
+        return "LRU"
+    if s.startswith("Prefetch Only"):
+        return "Prefetch" if float(lambda_val) == 0.0 else None
+    if s.startswith("Cache-Cond Only"):
+        return "Cache-Cond"
+    if s.startswith("Both"):
+        return "Hybrid"
+    return None
+
