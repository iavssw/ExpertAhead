+            part = part.strip()
+            if not part:
+                continue
+            norm = _normalize_ppl_policy_name(part)
+            if norm is None:
+                raise ValueError(
+                    f"unknown --ppl-policies entry {part!r}; "
+                    f"choose from {sorted(_PPL_POLICY_CHOICES)}"
+                )
+            out.add(norm)
+    return frozenset(out) if out else None
