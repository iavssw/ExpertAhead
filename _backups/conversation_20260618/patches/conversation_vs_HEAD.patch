+def _parse_ppl_policies(raw: Optional[Sequence[str]]) -> Optional[frozenset]:
+    """Normalize --ppl-policies values (e.g. hybrid or cache-cond,hybrid)."""
+    if not raw:
+        return None
+    out: set = set()
+    for item in raw:
