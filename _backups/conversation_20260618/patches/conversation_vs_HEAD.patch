+def _add_policy_column(df: pd.DataFrame) -> pd.DataFrame:
+    out = df.copy()
+    out["policy"] = [
+        _policy_label(l, lam)
+        for l, lam in zip(out.get("label", ""), out.get("lambda_val", 0))
+    ]
+    return out
+
